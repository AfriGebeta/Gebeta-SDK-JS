{
  "name": "gebeta-sdk-js",
  "version": "0.1.0",
  "private": true,
  "description": "Gebeta Maps SDK monorepo for JavaScript, React, and React Native",
  "workspaces": [
    "packages/*",
    "packages/client/*",
    "packages/server/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bash scripts/run-workspaces.sh build",
    "build:api": "yarn workspace @gebeta/api build",
    "lint": "bash scripts/run-workspaces.sh lint",
    "lint:fix": "bash scripts/run-workspaces.sh lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "bash scripts/run-workspaces.sh typecheck",
    "clean": "bash scripts/run-workspaces.sh clean",
    "link": "yarn workspace @gebeta/api build && yarn install",
    "ci": "yarn lint && yarn format:check && yarn typecheck",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "changeset publish",
    "examples:local": "node scripts/switch-deps.mjs --local && yarn install",
    "examples:npm": "node scripts/switch-deps.mjs --npm && yarn install",
    "bundle:audit": "node scripts/bundle-audit.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=4.0.0"
  },
  "packageManager": "yarn@4.12.0"
}
