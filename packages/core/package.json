{
  "name": "@gebeta/maps-core",
  "version": "0.1.0",
  "description": "Core platform-agnostic implementation for Gebeta Maps SDKs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@gebeta/maps-api": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
