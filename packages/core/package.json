{
  "name": "@gebeta/core",
  "version": "3.0.3",
  "description": "Core platform-agnostic implementation for Gebeta Maps SDKs",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./auth": {
      "import": "./dist/Auth/AuthManager.js",
      "types": "./dist/Auth/AuthManager.d.ts"
    },
    "./geocoding": {
      "import": "./dist/Geocoding/GeocodingManager.js",
      "types": "./dist/Geocoding/GeocodingManager.d.ts"
    },
    "./directions": {
      "import": "./dist/Directions/DirectionsManager.js",
      "types": "./dist/Directions/DirectionsManager.d.ts"
    },
    "./clustering": {
      "import": "./dist/Clustering/ClusteringManager.js",
      "types": "./dist/Clustering/ClusteringManager.d.ts"
    },
    "./fencing": {
      "import": "./dist/Fencing/FenceManager.js",
      "types": "./dist/Fencing/FenceManager.d.ts"
    },
    "./navigation": {
      "import": "./dist/Navigation/NavigationManager.js",
      "types": "./dist/Navigation/NavigationManager.d.ts"
    },
    "./tracking": {
      "import": "./dist/Tracking/TrackingManager.js",
      "types": "./dist/Tracking/TrackingManager.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "lint": "test -d src && eslint \"src/**/*.ts\" || echo 'No src directory - skipping lint'",
    "lint:fix": "test -d src && eslint \"src/**/*.ts\" --fix || echo 'No src directory - skipping lint'",
    "typecheck": "test -d src && (yarn workspace @gebeta/api build && tsc --noEmit) || echo 'No src directory - skipping typecheck'",
    "format": "test -d src && prettier --write \"src/**/*.ts\" || echo 'No src directory - skipping format'",
    "format:check": "test -d src && prettier --check \"src/**/*.ts\" || echo 'No src directory - skipping format check'",
    "test": "jest --testPathIgnorePatterns='integration'",
    "test:watch": "jest --watch --testPathIgnorePatterns='integration'",
    "test:coverage": "jest --coverage --testPathIgnorePatterns='integration'",
    "test:integration": "jest --testMatch='**/*.integration.test.ts'"
  },
  "dependencies": {
    "@gebeta/api": "workspace:*",
    "supercluster": "^8.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supercluster": "^7.1.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
